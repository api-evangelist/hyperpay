          "request": {
            "name": "Get payment status of a checkout",
            "description": {
              "content": "Retrieves the result of a checkout after the shopper submits the COPYandPAY widget. Pass the entityId as a query parameter and the Bearer token in the Authorization header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "checkouts",
                ":id",
                "payment"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "entityId",
                  "value": "<string>",
                  "description": "(Required) The channel (entity) identifier."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "id",
                  "description": "(Required) The checkout id returned by POST /v1/checkouts."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
