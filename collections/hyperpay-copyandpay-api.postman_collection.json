      "item": [
        {
          "id": "adec3f88-3c3c-4a0d-a5e9-fc44f6b3e7ae",
          "name": "Prepare a checkout",
          "request": {
            "name": "Prepare a checkout",
            "description": {
              "content": "Creates a checkout and returns a checkout `id` used to initialize the COPYandPAY JavaScript widget in the shopper's browser. Send entityId, amount, currency and paymentType (e.g. DB for debit, PA for pre-authorization).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "checkouts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "entityId",
                  "value": "<string>",
                  "description": "(Required) Channel (entity) identifier."
                },
                {
                  "disabled": false,
                  "key": "amount",
                  "value": "<string>",
                  "description": "(Required) Decimal amount as a string with two decimals."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "(Required) ISO 4217 currency code."
                },
                {
                  "disabled": false,
                  "key": "paymentType",
                  "value": "<string>",
                  "description": "(Required) DB = debit, PA = pre-authorization."
                },
                {
                  "disabled": false,
                  "key": "merchantTransactionId",
                  "value": "<string>"
                }
              ]
            }
          },
          "response": [
            {
              "id": "62347a35-a57c-4560-ba04-0a0e57fb753a",
              "name": "Checkout prepared.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "checkouts"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
