                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) Decimal amount as a string with two decimals.",
                        "type": "text/plain"
                      },
                      "key": "amount",
                      "value": "92.00"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) ISO 4217 currency code.",
                        "type": "text/plain"
                      },
                      "key": "currency",
                      "value": "SAR"
                    },
                    {
                      "disabled": false,
                      "description": {
                        "content": "(Required) DB = debit, PA = pre-authorization.",
                        "type": "text/plain"
                      },
                      "key": "paymentType",
                      "value": "<string>"
                    },
                    {
                      "disabled": false,
                      "key": "merchantTransactionId",
                      "value": "<string>"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
