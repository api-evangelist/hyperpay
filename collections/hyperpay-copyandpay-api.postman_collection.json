              "body": "{\n  \"id\": \"string\",\n  \"result\": {\n    \"code\": \"000.100.110\",\n    \"description\": \"Request successfully processed in 'Merchant in Integrator Test Mode'\"\n  },\n  \"buildNumber\": \"string\",\n  \"timestamp\": \"string\",\n  \"ndc\": \"string\"\n}",
